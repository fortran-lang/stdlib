#:include "common.fypp"
#:set R_KINDS_TYPES = list(zip(REAL_KINDS, REAL_TYPES, REAL_SUFFIX))
#:set KINDS_TYPES = R_KINDS_TYPES
#:set SPMM_KINDS_TYPES = R_KINDS_TYPES + list(zip(CMPLX_KINDS, CMPLX_TYPES, CMPLX_SUFFIX))
#:set OP_NAMES = ["add","sub","mul","div"]
#:set OP_SYMBOLS = ["+","-","*","/"]
#:set OPERATORS = list(zip(OP_NAMES, OP_SYMBOLS))
module test_sparse_spmv
    use testdrive, only : new_unittest, unittest_type, error_type, check, skip_test
    use stdlib_kinds, only: sp, dp, xdp, qp, int8, int16, int32, int64
    use stdlib_sparse
    use stdlib_constants
    use iso_c_binding, only: c_ptr, c_loc, c_associated
    use ieee_arithmetic, only: ieee_value, ieee_quiet_nan

    implicit none

contains

    !> Collect all exported unit tests
    subroutine collect_suite(testsuite)
        !> Collection of tests
        type(unittest_type), allocatable, intent(out) :: testsuite(:)

        testsuite = [ &
            new_unittest('spmm', test_spmm), &
            new_unittest('spmm_radix', test_spmm_radix), &
            new_unittest('spmm_reuse', test_spmm_reuse), &
            new_unittest('spmm_sparse_ops', test_spmm_sparse_ops), &
            new_unittest('spmm_empty', test_spmm_empty), &
            new_unittest('coo', test_coo), &
            new_unittest('coo2ordered', test_coo2ordered), &
            new_unittest('csr', test_csr), &
            new_unittest('csc', test_csc), &
            new_unittest('ell', test_ell),  &
            new_unittest('sellc', test_sellc),  &
            new_unittest('symmetries', test_symmetries), &
            new_unittest('diagonal', test_diagonal), &
            new_unittest('add_get_values', test_add_get_values),  &
            new_unittest('sparse_operators', test_sparse_operators), &
            new_unittest('add_block_symmetric_skip', test_add_block_symmetric_skip), &
            new_unittest('csc2dense', test_csc2dense) &
        ]
    end subroutine

    !> Check all SpMM overloads against intrinsic dense products.
    subroutine test_spmm(error)
        type(error_type), allocatable, intent(out) :: error
        #:for k, t, s in SPMM_KINDS_TYPES
        block
            integer, parameter :: wp = ${k}$
            integer :: stat, nnz_before
            integer(int32) :: work(8)
            type(c_ptr) :: data_address, index_address
            ${t}$ :: a(2,3), b(3,2), x(4,2), y(4,3)
            ${t}$ :: result(2,2), reference(2,2), left_result(4,3)
            ${t}$ :: transposed(3,2), expected(3,2)
            ${t}$ :: right_input(4,3), right_result(4,2), right_expected(4,2)
            type(COO_${s}$_type), target :: coo_a, coo_b, coo_c
            type(CSR_${s}$_type), target :: csr_a, csr_b, csr_c
            type(CSC_${s}$_type), target :: csc_a, csc_b, csc_c
            type(ELL_${s}$_type), target :: ell_a, ell_b, ell_c
            type(SELLC_${s}$_type), target :: sellc_a, sellc_b, sellc_c
            a = reshape(real([1,0,2,3,0,4],kind=wp),shape(a))
            b = reshape(real([2,0,0,3,1,4],kind=wp),shape(b))
            #:if t.startswith('complex')
            a(1,2) = cmplx(2,1,kind=wp)
            #:endif
            x = one_${s}$
            call dense2coo(a,coo_a)
            call coo2csr(coo_a,csr_a)
            call coo2csc(coo_a,csc_a)
            call csr2ell(csr_a,ell_a)
            call csr2sellc(csr_a,sellc_a,chunk=4)
            call dense2coo(b,coo_b)
            call coo2csr(coo_b,csr_b)
            call coo2csc(coo_b,csc_b)
            call csr2ell(csr_b,ell_b)
            call csr2sellc(csr_b,sellc_b)
            result = 2 * one_${s}$
            reference = 2 * matmul(a,b) + result
            call spmm(csr_a,b,result,alpha=2*one_${s}$,beta=one_${s}$)
            call check(error, all(abs(result-reference) < 20*epsilon(1._wp)), 'CSR x dense ${s}$')
            if (allocated(error)) return
            y = one_${s}$
            left_result = y
            left_result = 2*matmul(x,a) + left_result
            call spmm(x,csr_a,y,alpha=2*one_${s}$,beta=one_${s}$)
            call check(error, all(abs(y-left_result) < 20*epsilon(1._wp)), 'dense x CSR ${s}$')
            if (allocated(error)) return
            transposed = zero_${s}$
            expected = matmul(transpose(a),transpose(a(:,1:2)))
            call spmm(csr_a,transpose(a(:,1:2)),transposed,op=sparse_op_transpose)
            call check(error, all(abs(transposed-expected) < 20*epsilon(1._wp)), 'CSR transpose ${s}$')
            if (allocated(error)) return
            right_input = one_${s}$
            right_result = zero_${s}$
            right_expected = matmul(right_input,transpose(a))
            call spmm(right_input,csr_a,right_result,op=sparse_op_transpose)
            call check(error, all(abs(right_result-right_expected) < 20*epsilon(1._wp)), 'dense x CSR transpose ${s}$')
            if (allocated(error)) return
            #:for fmt in ["coo", "csc", "ell", "sellc"]
            result = 2 * one_${s}$
            call spmm(${fmt}$_a,b,result,alpha=2*one_${s}$,beta=one_${s}$)
            call check(error, all(abs(result-reference) < 20*epsilon(1._wp)), '${fmt.upper()}$ x dense ${s}$')
            if (allocated(error)) return
            y = one_${s}$
            call spmm(x,${fmt}$_a,y,alpha=2*one_${s}$,beta=one_${s}$)
            call check(error, all(abs(y-left_result) < 20*epsilon(1._wp)), 'dense x ${fmt.upper()}$ ${s}$')
            if (allocated(error)) return
            transposed = zero_${s}$
            call spmm(${fmt}$_a,transpose(a(:,1:2)),transposed,op=sparse_op_transpose)
            call check(error, all(abs(transposed-expected) < 20*epsilon(1._wp)), '${fmt.upper()}$ transpose ${s}$')
            if (allocated(error)) return
            right_result = zero_${s}$
            call spmm(right_input,${fmt}$_a,right_result,op=sparse_op_transpose)
            call check(error, all(abs(right_result-right_expected) < 20*epsilon(1._wp)), &
                'dense x ${fmt.upper()}$ transpose ${s}$')
            if (allocated(error)) return
            #:endfor
            #:if t.startswith('complex')
            #:for fmt in ["coo", "csc", "ell", "sellc"]
            transposed = zero_${s}$
            call spmm(${fmt}$_a,transpose(a(:,1:2)),transposed,op=sparse_op_hermitian)
            call check(error, all(abs(transposed-matmul(conjg(transpose(a)),transpose(a(:,1:2)))) &
                < 20*epsilon(1._wp)), '${fmt.upper()}$ hermitian ${s}$')
            if (allocated(error)) return
            right_result = zero_${s}$
            call spmm(right_input,${fmt}$_a,right_result,op=sparse_op_hermitian)
            call check(error, all(abs(right_result-matmul(right_input,conjg(transpose(a)))) &
                < 20*epsilon(1._wp)), 'dense x ${fmt.upper()}$ hermitian ${s}$')
            if (allocated(error)) return
            #:endfor
            #:endif
            #:for fmt in ["coo", "csr", "csc", "ell", "sellc"]
            call spmm(${fmt}$_a,${fmt}$_b,${fmt}$_c,stat=stat)
            call check(error, stat == spmm_success, '${fmt.upper()}$ one-shot ${s}$')
            if (allocated(error)) return
            result = zero_${s}$
            call spmm(${fmt}$_c,reshape([one_${s}$,zero_${s}$,zero_${s}$,one_${s}$],[2,2]),result)
            call check(error, all(abs(result-matmul(a,b)) < 20*epsilon(1._wp)), &
                '${fmt.upper()}$ sparse product ${s}$')
            if (allocated(error)) return
            call spmm_prepare(${fmt}$_a,${fmt}$_b,${fmt}$_c,stat=stat)
            call check(error, stat == spmm_success .and. all(${fmt}$_c%data == zero_${s}$), &
                '${fmt.upper()}$ independent symbolic preparation ${s}$')
            if (allocated(error)) return
            data_address = c_loc(${fmt}$_c%data)
            #:if fmt in ["coo", "ell"]
            index_address = c_loc(${fmt}$_c%index)
            #:elif fmt == "csc"
            index_address = c_loc(${fmt}$_c%row)
            #:else
            index_address = c_loc(${fmt}$_c%col)
            #:endif
            nnz_before = ${fmt}$_c%nnz
            call spmm(${fmt}$_a,${fmt}$_b,${fmt}$_c,allow_resize=.false.,work=work,stat=stat)
            call check(error, stat == spmm_success, '${fmt.upper()}$ prepared numeric product ${s}$')
            if (allocated(error)) return
            ${fmt}$_a%data = 2*${fmt}$_a%data
            call spmm(${fmt}$_a,${fmt}$_b,${fmt}$_c,allow_resize=.false.,work=work,stat=stat)
            result = zero_${s}$
            call spmm(${fmt}$_c,reshape([one_${s}$,zero_${s}$,zero_${s}$,one_${s}$],[2,2]),result)
            call check(error, stat == spmm_success .and. &
                all(abs(result-2*matmul(a,b)) < 40*epsilon(1._wp)), &
                '${fmt.upper()}$ changed values ${s}$')
            if (allocated(error)) return
            ${fmt}$_b%data = 2*${fmt}$_b%data
            call spmm(${fmt}$_a,${fmt}$_b,${fmt}$_c,alpha=one_${s}$/4, &
                allow_resize=.false.,work=work,stat=stat)
            result = zero_${s}$
            call spmm(${fmt}$_c,reshape([one_${s}$,zero_${s}$,zero_${s}$,one_${s}$],[2,2]),result)
            call check(error, stat == spmm_success .and. &
                all(abs(result-matmul(a,b)) < 40*epsilon(1._wp)), '${fmt.upper()}$ scaling ${s}$')
            if (allocated(error)) return
            call spmm(${fmt}$_a,${fmt}$_b,${fmt}$_c,alpha=zero_${s}$, &
                allow_resize=.false.,work=work,stat=stat)
            call check(error, stat == spmm_success .and. all(${fmt}$_c%data == zero_${s}$) .and. &
                ${fmt}$_c%nnz == nnz_before .and. c_associated(data_address,c_loc(${fmt}$_c%data)), &
                '${fmt.upper()}$ zero scale preserves result storage ${s}$')
            if (allocated(error)) return
            #:if fmt in ["coo", "ell"]
            call check(error, c_associated(index_address,c_loc(${fmt}$_c%index)), 'fixed index address')
            #:elif fmt == "csc"
            call check(error, c_associated(index_address,c_loc(${fmt}$_c%row)), 'fixed index address')
            #:else
            call check(error, c_associated(index_address,c_loc(${fmt}$_c%col)), 'fixed index address')
            #:endif
            if (allocated(error)) return
            #:endfor
        end block
        #:endfor
    end subroutine

    !> Exercise the sorted CSC result path with many entries per column.
    subroutine test_spmm_radix(error)
        type(error_type), allocatable, intent(out) :: error
        integer, parameter :: n = 1024, entries_per_column = 20
        integer :: column, entry, row, position
        type(COO_dp_type) :: coo, coo_csc, coo_csr, duplicate_coo, duplicate_result, identity_coo
        type(CSC_dp_type) :: csc, csc_result
        type(CSR_dp_type) :: csr, csr_result
        real(dp) :: dense_result(2,2), eye2(2,2)

        call coo%malloc(n,n,n*entries_per_column)
        position = 0
        do column = 1, n
            do entry = 1, entries_per_column
                row = mod(column + 97*entry*entry + 17*entry - 1,n) + 1
                position = position + 1
                coo%index(:,position) = [row,column]
                coo%data(position) = real(mod(37*column + entry,19) + 1,dp) / 19._dp
            end do
        end do
        call coo2csc(coo,csc)
        call coo2csr(coo,csr,sort_data=.true.)
        call spmm(csc,csc,csc_result)
        call spmm(csr,csr,csr_result)
        call check(error, csc_result%nnz == csr_result%nnz, 'CSC product nnz')
        if (allocated(error)) return
        do column = 1, n
            call check(error, all(csc_result%row(csc_result%colptr(column)+1: &
                csc_result%colptr(column+1)-1) > &
                csc_result%row(csc_result%colptr(column): &
                csc_result%colptr(column+1)-2)), 'CSC rows must be sorted')
            if (allocated(error)) return
        end do
        call csc2coo(csc_result,coo_csc)
        call csr2coo(csr_result,coo_csr)
        call check(error, all(coo_csc%index == coo_csr%index), 'CSC product positions')
        if (allocated(error)) return
        call check(error, all(abs(coo_csc%data-coo_csr%data) < &
            100*epsilon(1._dp)*max(1._dp,abs(coo_csr%data))), 'CSC product values')
        if (allocated(error)) return

        ! Duplicate COO positions contribute to the same product entry.
        call duplicate_coo%malloc(2,2,3)
        duplicate_coo%index(:,1) = [1,1]
        duplicate_coo%index(:,2) = [1,1]
        duplicate_coo%index(:,3) = [2,2]
        duplicate_coo%data = [2._dp,3._dp,1._dp]
        call identity_coo%malloc(2,2,2)
        identity_coo%index(:,1) = [1,1]
        identity_coo%index(:,2) = [2,2]
        identity_coo%data = 1._dp
        call spmm(duplicate_coo,identity_coo,duplicate_result)
        eye2 = 0._dp
        eye2(1,1) = 1._dp
        eye2(2,2) = 1._dp
        dense_result = 0._dp
        call spmm(duplicate_result,eye2,dense_result)
        call check(error, all(abs(dense_result-reshape([5._dp,0._dp,0._dp,1._dp],[2,2])) &
            < 100*epsilon(1._dp)), 'duplicate COO input')
    end subroutine

    !> Verify plan-free reuse, reconstruction, and shape/workspace checks.
    subroutine test_spmm_reuse(error)
        type(error_type), allocatable, intent(out) :: error
        type(CSR_dp_type), target :: a, b, c, missing
        type(c_ptr) :: values_address, columns_address, pointer_address
        integer(int32) :: work(3)
        integer :: stat
        real(dp) :: saved(2)
        call a%malloc(2,2,3)
        a%rowptr = [1,3,4]
        a%col = [1,2,2]
        a%data = [1._dp,-1._dp,2._dp]
        call b%malloc(2,2,2)
        b%rowptr = [1,2,3]
        b%col = [2,2]
        b%data = 1._dp
        call spmm_prepare(a,b,c,stat=stat)
        call check(error, stat == spmm_success .and. c%nnz == 2 .and. &
            all(c%data == 0._dp), 'prepared structure independent of cancellation')
        if (allocated(error)) return
        values_address = c_loc(c%data)
        columns_address = c_loc(c%col)
        pointer_address = c_loc(c%rowptr)
        call spmm(a,b,c,allow_resize=.false.,work=work,stat=stat)
        call check(error, stat == spmm_success .and. &
            all(abs(c%data-[0._dp,2._dp]) < 10*epsilon(1._dp)), 'cancellation')
        if (allocated(error)) return
        a%data = [1._dp,3._dp,2._dp]
        call spmm(a,b,c,allow_resize=.false.,work=work,stat=stat)
        call check(error, stat == spmm_success .and. all(c%data == [4._dp,2._dp]) &
            .and. c_associated(values_address,c_loc(c%data)) &
            .and. c_associated(columns_address,c_loc(c%col)) &
            .and. c_associated(pointer_address,c_loc(c%rowptr)), 'result buffers reused')
        if (allocated(error)) return
        block
            type(CSR_dp_type), target :: superset
            type(c_ptr) :: original_address
            call superset%malloc(2,2,4)
            superset%rowptr = [1,3,5]
            superset%col = [1,2,1,2]
            superset%data = -17._dp
            original_address = c_loc(superset%data)
            call spmm(a,b,superset,allow_resize=.false.,work=work,stat=stat)
            call check(error, stat == spmm_success .and. all(superset%data == [0._dp,4._dp,0._dp,2._dp]) &
                .and. c_associated(original_address,c_loc(superset%data)), 'independently precomputed superset')
            if (allocated(error)) return
        end block
        a%data = ieee_value(0._dp,ieee_quiet_nan)
        call spmm_prepare(a,b,c,stat=stat)
        call check(error, stat == spmm_success .and. c%nnz == 2 .and. &
            all(c%data == 0._dp), 'symbolic construction ignores NaNs')
        if (allocated(error)) return
        call spmm(a,b,c,alpha=0._dp,allow_resize=.false.,work=work,stat=stat)
        call check(error, stat == spmm_success .and. all(c%data == 0._dp), 'zero alpha skips values')
        if (allocated(error)) return
        a%data = 1._dp
        b%col = [1,1]
        call spmm(a,b,c,allow_resize=.true.,stat=stat)
        call check(error, stat == spmm_success .and. all(c%col == 1) .and. &
            all(c%data == [2._dp,1._dp]), 'explicit reconstruction after a structure change')
        if (allocated(error)) return
        saved = c%data
        call spmm(a,b,missing,allow_resize=.false.,stat=stat)
        call check(error, stat == spmm_invalid_input, 'reuse requires an allocated target')
        if (allocated(error)) return
        call spmm(a,b,c,allow_resize=.false.,work=work(:1),stat=stat)
        call check(error, stat == spmm_invalid_input .and. all(c%data == saved), 'workspace size')
        if (allocated(error)) return
        call spmm(a,b,c,op_a='Q',stat=stat)
        call check(error, stat == spmm_invalid_input .and. all(c%data == saved), 'invalid operation')
        if (allocated(error)) return
        c%ncols = 3
        call spmm(a,b,c,allow_resize=.false.,stat=stat)
        call check(error, stat == spmm_invalid_input .and. all(c%data == saved), 'target dimensions')
        if (allocated(error)) return
        c%ncols = 2
        b%nrows = 3
        call spmm_prepare(a,b,c,stat=stat)
        call check(error, stat == spmm_invalid_input .and. all(c%data == saved), 'input dimensions')
        if (allocated(error)) return
        b%nrows = 2
        a%storage = sparse_lower
        call spmm_prepare(a,b,c,stat=stat)
        call check(error, stat == spmm_invalid_input .and. all(c%data == saved), 'full storage required')
        if (allocated(error)) return
        a%storage = sparse_full
        b%rowptr = [1,3]
        call spmm_prepare(a,b,c,stat=stat)
        call check(error, stat == spmm_invalid_input .and. all(c%data == saved), 'pointer array shape')
        if (allocated(error)) return
        block
            type(COO_dp_type) :: coo
            type(CSR_dp_type) :: csr
            type(SELLC_dp_type) :: sellc, product
            real(dp) :: matrix(3,3), identity(3,3), actual(3,3)
            integer :: i
            matrix = reshape([1._dp,0._dp,2._dp,0._dp,3._dp,0._dp,4._dp,0._dp,5._dp],[3,3])
            call dense2coo(matrix,coo)
            call coo2csr(coo,csr)
            call csr2sellc(csr,sellc)
            call spmm(sellc,sellc,product,work=work)
            identity = 0._dp
            do i = 1, 3
                identity(i,i) = 1._dp
            end do
            actual = 0._dp
            call spmm(product,identity,actual)
            call check(error, all(abs(actual-matmul(matrix,matrix)) < 100*epsilon(1._dp)), &
                'SELLC product with uneven row lengths')
            if (allocated(error)) return
            call check(error, product%col(1,3) == 1 .and. product%data(1,3) == 0._dp &
                .and. product%data(1,1) == 9._dp, 'SELLC column-one padding remains zero')
            if (allocated(error)) return
        end block
        block
            type(CSR_dp_type) :: empty_a, empty_b, empty_c
            call empty_a%malloc(2,0,0)
            empty_a%rowptr = 1
            call empty_b%malloc(0,3,0)
            empty_b%rowptr = 1
            call spmm_prepare(empty_a,empty_b,empty_c,stat=stat)
            call check(error, stat == spmm_success .and. empty_c%nrows == 2 &
                .and. empty_c%ncols == 3 .and. empty_c%nnz == 0, 'empty preparation')
            if (allocated(error)) return
            call spmm(empty_a,empty_b,empty_c,allow_resize=.false.,work=work,stat=stat)
            call check(error, stat == spmm_success, 'empty numeric product')
            if (allocated(error)) return
        end block
        block
            type(CSC_dp_type) :: zero_a, zero_b, zero_c
            call zero_a%malloc(0,2,0)
            zero_a%colptr = 1
            call zero_b%malloc(2,3,0)
            zero_b%colptr = 1
            call spmm_prepare(zero_a,zero_b,zero_c,stat=stat)
            call check(error, stat == spmm_success .and. zero_c%nrows == 0 &
                .and. zero_c%ncols == 3 .and. zero_c%nnz == 0, 'zero-row preparation')
            if (allocated(error)) return
            call spmm(zero_a,zero_b,zero_c,allow_resize=.false.,work=work,stat=stat)
            call check(error, stat == spmm_success, 'zero-row product')
        end block
    end subroutine test_spmm_reuse

    !> Check every operation pair and every public array kernel on rectangular inputs.
    subroutine test_spmm_sparse_ops(error)
        type(error_type), allocatable, intent(out) :: error
        character(1), parameter :: ops(3) = ['N','T','H']
        #:for k, t, s in SPMM_KINDS_TYPES
        #:for fmt in ["coo", "csr", "csc", "ell", "sellc"]
        block
            integer, parameter :: wp = ${k}$
            ${t}$ :: base_a(2,3), base_b(3,4), effective_a(2,3), effective_b(3,4)
            ${t}$ :: expected(2,4), actual(2,4), eye4(4,4)
            ${t}$, allocatable :: a(:,:), b(:,:)
            type(COO_${s}$_type) :: coo_a, coo_b
            type(CSR_${s}$_type) :: csr_a, csr_b
            type(${fmt.upper()}$_${s}$_type), target :: sa, sb, sc
            integer(int32) :: work(4)
            integer :: ia, ib, j, stat
            type(c_ptr) :: address
            base_a = reshape(real([1,0,2,3,0,4],wp),[2,3])
            base_b = reshape(real([2,0,1,3,1,0,0,2,1,1,0,3],wp),[3,4])
            #:if t.startswith('complex')
            base_a(1,2) = cmplx(2._wp,1._wp,wp)
            base_b(2,2) = cmplx(1._wp,-2._wp,wp)
            #:endif
            eye4 = zero_${s}$
            do j = 1, 4
                eye4(j,j) = one_${s}$
            end do
            do ia = 1, 3
                do ib = 1, 3
                    a = base_a
                    b = base_b
                    if (ia > 1) a = transpose(base_a)
                    if (ib > 1) b = transpose(base_b)
                    effective_a = base_a
                    effective_b = base_b
                    #:if t.startswith('complex')
                    if (ia == 3) effective_a = conjg(base_a)
                    if (ib == 3) effective_b = conjg(base_b)
                    #:endif
                    expected = matmul(effective_a,effective_b)
                    call dense2coo(a,coo_a)
                    call dense2coo(b,coo_b)
                    #:if fmt == 'coo'
                    ! Input coordinates may be unordered; preparation orders only C.
                    coo_a%index = coo_a%index(:,coo_a%nnz:1:-1)
                    coo_a%data = coo_a%data(coo_a%nnz:1:-1)
                    coo_a%is_sorted = .false.
                    sa = coo_a
                    sb = coo_b
                    #:elif fmt == 'csr'
                    call coo2csr(coo_a,sa)
                    call coo2csr(coo_b,sb)
                    #:elif fmt == 'csc'
                    call coo2csc(coo_a,sa)
                    call coo2csc(coo_b,sb)
                    #:else
                    call coo2csr(coo_a,csr_a)
                    call coo2csr(coo_b,csr_b)
                    call csr2${fmt}$(csr_a,sa)
                    call csr2${fmt}$(csr_b,sb)
                    #:endif
                    call spmm_prepare(sa,sb,sc,op_a=ops(ia),op_b=ops(ib),stat=stat)
                    call check(error, stat == spmm_success .and. sc%nrows == 2 .and. sc%ncols == 4, &
                        '${fmt.upper()}$ operated preparation ${s}$')
                    if (allocated(error)) return
                    address = c_loc(sc%data)
                    call spmm(sa,sb,sc,op_a=ops(ia),op_b=ops(ib),allow_resize=.false.,work=work,stat=stat)
                    call check(error, stat == spmm_success .and. c_associated(address,c_loc(sc%data)), &
                        '${fmt.upper()}$ operated reuse ${s}$')
                    if (allocated(error)) return
                    actual = zero_${s}$
                    call spmm(sc,eye4,actual)
                    call check(error, all(abs(actual-expected) < 100*epsilon(1._wp)), &
                        '${fmt.upper()}$ op(A)*op(B) ${s}$')
                    if (allocated(error)) return
                    #:if fmt in ['coo','ell']
                    call spmm_kernel_${fmt}$(ops(ia),ops(ib),one_${s}$,[sa%nrows,sa%ncols], &
                        [sb%nrows,sb%ncols],sa%data,sa%index,sb%data,sb%index,sc%data,sc%index,work)
                    #:elif fmt == 'csc'
                    call spmm_kernel_csc(ops(ia),ops(ib),one_${s}$,[sa%nrows,sa%ncols], &
                        [sb%nrows,sb%ncols],sa%data,sa%colptr,sa%row,sb%data,sb%colptr,sb%row, &
                        sc%data,sc%colptr,sc%row,work)
                    #:else
                    call spmm_kernel_${fmt}$(ops(ia),ops(ib),one_${s}$,[sa%nrows,sa%ncols], &
                        [sb%nrows,sb%ncols],sa%data,sa%rowptr,sa%col,sb%data,sb%rowptr,sb%col, &
                        sc%data,sc%rowptr,sc%col,work)
                    #:endif
                    actual = zero_${s}$
                    call spmm(sc,eye4,actual)
                    call check(error, all(abs(actual-expected) < 100*epsilon(1._wp)), &
                        '${fmt.upper()}$ public array kernel ${s}$')
                    if (allocated(error)) return
                end do
            end do
        end block
        #:endfor
        #:endfor
    end subroutine test_spmm_sparse_ops

    !> Empty dimensions must also work for padding formats and transposed factors.
    subroutine test_spmm_empty(error)
        type(error_type), allocatable, intent(out) :: error
        integer :: scenario
        #:for fmt in ["coo", "csr", "csc", "ell", "sellc"]
        do scenario = 1, 4
            block
                type(${fmt.upper()}$_dp_type) :: a, b, c
                integer(int32) :: work(3)
                integer :: stat, expected_rows, expected_cols
                character(1) :: op_a
                a%nrows = 2
                a%ncols = 0
                b%nrows = 0
                b%ncols = 3
                op_a = 'N'
                expected_rows = 2
                expected_cols = 3
                if (scenario == 2) then
                    a%nrows = 0
                    a%ncols = 2
                    op_a = 'T'
                else if (scenario == 3) then
                    a%nrows = 0
                    a%ncols = 2
                    b%nrows = 2
                    expected_rows = 0
                else if (scenario == 4) then
                    a%ncols = 3
                    b%nrows = 3
                    b%ncols = 0
                    expected_cols = 0
                end if
                #:for x in ['a','b']
                #:if fmt == 'coo'
                allocate(${x}$%index(2,0),${x}$%data(0))
                #:elif fmt == 'csr'
                allocate(${x}$%rowptr(${x}$%nrows+1),source=1_int32)
                allocate(${x}$%col(0),${x}$%data(0))
                #:elif fmt == 'csc'
                allocate(${x}$%colptr(${x}$%ncols+1),source=1_int32)
                allocate(${x}$%row(0),${x}$%data(0))
                #:elif fmt == 'ell'
                ${x}$%K = 0
                allocate(${x}$%index(${x}$%nrows,0),${x}$%data(${x}$%nrows,0))
                #:else
                ${x}$%chunk_size = 4
                allocate(${x}$%rowptr((${x}$%nrows+3)/4+1),source=1_int32)
                allocate(${x}$%col(4,0),${x}$%data(4,0))
                #:endif
                #:endfor
                call spmm_prepare(a,b,c,op_a=op_a,stat=stat)
                call check(error, stat == spmm_success .and. c%nrows == expected_rows &
                    .and. c%ncols == expected_cols .and. size(c%data) == 0, '${fmt.upper()}$ empty structure')
                if (allocated(error)) return
                call spmm(a,b,c,op_a=op_a,allow_resize=.false.,work=work,stat=stat)
                call check(error, stat == spmm_success, '${fmt.upper()}$ empty numeric product')
                if (allocated(error)) return
            end block
        end do
        #:endfor
    end subroutine test_spmm_empty

    subroutine test_coo(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            type(COO_${s1}$_type) :: COO
            ${t1}$, parameter :: alpha = 1._wp
            ${t1}$, parameter :: beta = 0._wp
            ${t1}$, allocatable :: dense(:,:)
            ${t1}$, allocatable :: vec_x(:)
            ${t1}$, allocatable :: vec_y1(:), vec_y2(:)

            allocate( dense(4,5) , source = &
                    reshape(real([9,4, 0,4, &
                                  0,7, 8,0, &
                                  0,0,-1,5, &
                                  0,0, 8,6, &
                                 -3,0, 0,0],kind=wp),[4,5]) )
            
            call dense2coo( dense , COO )
            
            allocate( vec_x(5)  , source = 1._wp )
            allocate( vec_y1(4) , source = 0._wp )
            allocate( vec_y2(4) , source = 0._wp )

            vec_y1 = matmul( dense, vec_x )
            
            call check(error, all(vec_y1 == real([6,11,15,15],kind=wp)) )
            if (allocated(error)) return

            ! High-level API
            call spmv( COO, vec_x, vec_y2 )
            call check(error, all(vec_y1 == vec_y2) )
            if (allocated(error)) return

            ! Low-level API
            call spmv_kernel_coo(sparse_op_none, alpha, &
                COO%data ,COO%index, COO%storage, &
                vec_x, beta, vec_y2 )
            call check(error, all(vec_y1 == vec_y2), 'COO - low level API: wrong output' )
            if (allocated(error)) return

            ! Test in-place transpose
            vec_y1 = 1._wp
            ! High-level API
            call spmv( COO, vec_y1, vec_x, op=sparse_op_transpose )
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)) )
            if (allocated(error)) return

            ! Low-level API
            call spmv_kernel_coo(sparse_op_transpose, alpha, &
                COO%data ,COO%index, COO%storage, &
                vec_y1, beta, vec_x)
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)), 'COO - transpose - low level API: wrong output' )
            if (allocated(error)) return
 
        end block
        #:endfor
    end subroutine

    subroutine test_coo2ordered(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        type(COO_sp_type) :: COO
        integer :: row(12), col(12)
        real    :: data(12)

        row = [1,1,1,2,2,3,2,2,2,3,3,4]
        col = [2,3,4,3,4,4,3,4,5,4,5,5]
        data = 1.0

        call from_ijv(COO,row,col,data)

        call coo2ordered(COO,sort_data=.true.)
        call check(error, COO%nnz < 12 .and. COO%nnz == 9 )
        if (allocated(error)) return

        call check(error, all(COO%data==[1,1,1,2,2,1,2,1,1])  )
        if (allocated(error)) return

        call check(error, all(COO%index(1,:)==[1,1,1,2,2,2,3,3,4])  )
        if (allocated(error)) return

        call check(error, all(COO%index(2,:)==[2,3,4,3,4,5,4,5,5])  )
        if (allocated(error)) return

    end subroutine 

    subroutine test_csr(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            type(CSR_${s1}$_type) :: CSR
            ${t1}$, parameter :: alpha = 1._wp
            ${t1}$, parameter :: beta = 0._wp
            ${t1}$, allocatable :: vec_x(:)
            ${t1}$, allocatable :: vec_y(:)

            call CSR%malloc(4,5,10)
            CSR%data(:)   = real([9,-3,4,7,8,-1,8,4,5,6],kind=wp)
            CSR%col(:)    = [1,5,1,2,2,3,4,1,3,4]
            CSR%rowptr(:) = [1,3,5,8,11]
            
            allocate( vec_x(5) , source = 1._wp )
            allocate( vec_y(4) , source = 0._wp )
            ! High-level API
            call spmv( CSR, vec_x, vec_y )
            
            call check(error, all(vec_y == real([6,11,15,15],kind=wp)), 'CSR - high-level API - wrong output' )
            if (allocated(error)) return

            ! Low-level API
            call spmv_kernel_csr(sparse_op_none, alpha, &
                CSR%data, CSR%col, CSR%rowptr, CSR%storage, &
                vec_x, beta, vec_y )
            
            call check(error, all(vec_y == real([6,11,15,15],kind=wp)), 'CSR - low-level API - wrong output' )
            if (allocated(error)) return

            ! Test in-place transpose
            vec_y = 1._wp
            ! High-level API
            call spmv( CSR, vec_y, vec_x, op=sparse_op_transpose )
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)), 'CSR transpose - high-level API - wrong output' )
            if (allocated(error)) return

            call spmv_kernel_csr(sparse_op_transpose, alpha, &
                CSR%data, CSR%col, CSR%rowptr, CSR%storage, &
                vec_y, beta, vec_x)
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)), 'CSR transpose - low-level API - wrong output' )
            if (allocated(error)) return
        end block
        #:endfor
    end subroutine

    subroutine test_csc(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            type(CSC_${s1}$_type) :: CSC
            ${t1}$, parameter :: alpha = 1._wp
            ${t1}$, parameter :: beta = 0._wp
            ${t1}$, allocatable :: vec_x(:)
            ${t1}$, allocatable :: vec_y(:)

            call CSC%malloc(4,5,10)
            CSC%data(:)   = real([9,4,4,7,8,-1,5,8,6,-3],kind=wp)
            CSC%row(:)    = [1,2,4,2,3,3,4,3,4,1]
            CSC%colptr(:) = [1,4,6,8,10,11]
            
            allocate( vec_x(5) , source = 1._wp )
            allocate( vec_y(4) , source = 0._wp )
            !High-level API
            call spmv( CSC, vec_x, vec_y )
            
            call check(error, all(vec_y == real([6,11,15,15],kind=wp)) )
            if (allocated(error)) return

            !High-level API
            call spmv_kernel_csc(sparse_op_none, alpha, &
                CSC%data, CSC%colptr, CSC%row, CSC%storage, &
                vec_x, beta, vec_y )
            
            call check(error, all(vec_y == real([6,11,15,15],kind=wp)), 'CSC - low-level API - wrong output' )
            if (allocated(error)) return

            ! Test in-place transpose
            vec_y = 1._wp
            !High-level API
            call spmv( CSC, vec_y, vec_x, op=sparse_op_transpose )
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)) )
            if (allocated(error)) return

            !Low-level API
            call spmv_kernel_csc(sparse_op_transpose, alpha, &
                CSC%data, CSC%colptr, CSC%row, CSC%storage, &
                vec_y, beta, vec_x)
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)), 'CSC tranpose - low-level API - wrong output' )
            if (allocated(error)) return

        end block
        #:endfor
    end subroutine

    subroutine test_ell(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            type(ELL_${s1}$_type) :: ELL
            ${t1}$, parameter :: alpha = 1._wp
            ${t1}$, parameter :: beta = 0._wp
            ${t1}$, allocatable :: vec_x(:)
            ${t1}$, allocatable :: vec_y(:)

            call ELL%malloc(4,5,3)
            ELL%data(1,1:3)   = real([9,-3,0],kind=wp)
            ELL%data(2,1:3)   = real([4,7,0],kind=wp)
            ELL%data(3,1:3)   = real([8,-1,8],kind=wp)
            ELL%data(4,1:3)   = real([4,5,6],kind=wp)

            ELL%index(1,1:3) = [1,5,0]
            ELL%index(2,1:3) = [1,2,0]
            ELL%index(3,1:3) = [2,3,4]
            ELL%index(4,1:3) = [1,3,4]
            
            allocate( vec_x(5) , source = 1._wp )
            allocate( vec_y(4) , source = 0._wp )
            !High-level API
            call spmv( ELL, vec_x, vec_y )
            
            call check(error, all(vec_y == real([6,11,15,15],kind=wp)) )
            if (allocated(error)) return

            !Low-level API
            call spmv_kernel_ell(sparse_op_none, alpha, &
                ELL%data, ELL%index, ELL%storage, &
                vec_x, beta, vec_y )

            call check(error, all(vec_y == real([6,11,15,15],kind=wp)), 'ELL - low-level API - wrong output' )
            if (allocated(error)) return

            ! Test in-place transpose
            vec_y = 1._wp
            !High-level API
            call spmv( ELL, vec_y, vec_x, op=sparse_op_transpose )
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)) )
            if (allocated(error)) return

            !Low-level API
            call spmv_kernel_ell(sparse_op_transpose, alpha, &
                ELL%data, ELL%index, ELL%storage, &
                vec_y, beta, vec_x)
            call check(error, all(vec_x == real([17,15,4,14,-3],kind=wp)), 'ELL tranpose - low-level API - wrong output' )
            if (allocated(error)) return
        end block
        #:endfor
        
    end subroutine

    subroutine test_sellc(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            type(SELLC_${s1}$_type) :: SELLC
            type(CSR_${s1}$_type)   :: CSR
            ${t1}$, parameter :: alpha = 1._wp
            ${t1}$, parameter :: beta = 0._wp
            ${t1}$, allocatable :: vec_x(:)
            ${t1}$, allocatable :: vec_y(:), vec_y2(:)
            integer :: i

            call CSR%malloc(6,6,17)
            !           1   2   3   4   5   6 
            CSR%col = [ 1,      3,  4,         &
                            2,  3,      5,  6, &
                        1,  2,  3,             &
                                        5,  6, &
                                    4,  5,     &
                            2,          5,  6]
            CSR%rowptr = [1,4,8,11,13,15,18]
            CSR%data = [(real(i,kind=wp),i=1,CSR%nnz)] 
            
            call csr2sellc(CSR,SELLC,4)

            allocate( vec_x(6) , source = 1._wp )
            allocate( vec_y(6) , source = 0._wp )
            
            !High-level API
            call spmv( SELLC, vec_x, vec_y )
            
            call check(error, all(vec_y == real([6,22,27,23,27,48],kind=wp)), 'SELLC - high-level API - wrong output' )
            if (allocated(error)) return

            !Low-level API
            call spmv_kernel_sellc(sparse_op_none, alpha, &
                SELLC%data, SELLC%rowptr, SELLC%col, SELLC%storage, &
                vec_x, beta, vec_y )

            call check(error, all(vec_y == real([6,22,27,23,27,48],kind=wp)), 'SELLC - low-level API - wrong output' )
            if (allocated(error)) return

            ! Test in-place transpose
            vec_x = real( [1,2,3,4,5,6] , kind=wp )
            call spmv( CSR, vec_x, vec_y , op = sparse_op_transpose )
            allocate( vec_y2(6) , source = 0._wp )
            !High-level API
            call spmv( SELLC, vec_x, vec_y2 , op = sparse_op_transpose )

            call check(error, all(vec_y == vec_y2), 'SELLC tranpose - high-level API - wrong output' )
            if (allocated(error)) return

            !Low-level API
            call spmv_kernel_sellc(sparse_op_transpose, alpha, &
                SELLC%data, SELLC%rowptr, SELLC%col, SELLC%storage, &
                vec_x, beta, vec_y2)

            call check(error, all(vec_y == vec_y2), 'SELLC tranpose - low-level API - wrong output' )
            if (allocated(error)) return

        end block
        #:endfor
    end subroutine

    subroutine test_symmetries(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            type(COO_${s1}$_type) :: COO_low, COO_upper
            type(CSR_${s1}$_type) :: CSR_low, CSR_upper
            type(CSC_${s1}$_type) :: CSC_low, CSC_upper
            type(ELL_${s1}$_type) :: ELL_low, ELL_upper
            integer, parameter :: ndim = 4
            ${t1}$, parameter :: dense(ndim,ndim) = reshape(real([1,2,0,0, &
                                                            2,3,4,0, &
                                                            0,4,5,6, &
                                                            0,0,6,7], kind=wp), [ndim,ndim])
            ${t1}$, parameter :: vec_x(ndim) = real([1,2,3,4], kind=wp)
            ${t1}$, parameter :: vec_y_ref(ndim) = matmul(dense, vec_x)
            ${t1}$ :: dense_low(ndim,ndim), dense_upper(ndim,ndim)
            ${t1}$ :: vec_y(ndim)
            integer :: i, j

            vec_y = 0._wp

            dense_low = dense
            dense_upper = dense

            do i = 1, ndim
                do j = i + 1, ndim
                    dense_low(i,j) = 0._wp
                    dense_upper(j,i) = 0._wp
                end do
            end do

            call dense2coo(dense_low, COO_low)
            COO_low%storage = sparse_lower
            call coo2csr(COO_low, CSR_low)
            call coo2csc(COO_low, CSC_low)
            call csr2ell(CSR_low, ELL_low)

            call dense2coo(dense_upper, COO_upper)
            COO_upper%storage = sparse_upper
            call coo2csr(COO_upper, CSR_upper)
            call coo2csc(COO_upper, CSC_upper)
            call csr2ell(CSR_upper, ELL_upper)

            vec_y = 0._wp
            call spmv(COO_low, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in COO lower ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(COO_low, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in COO lower ${s1}$ transpose spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(COO_upper, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in COO upper ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(COO_upper, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in COO upper ${s1}$ transpose spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSR_low, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in CSR lower ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSR_low, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in CSR lower ${s1}$ transpose spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSR_upper, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in CSR upper ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSR_upper, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in CSR upper ${s1}$ transpose spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSC_low, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in CSC lower ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSC_low, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in CSC lower ${s1}$ transpose spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSC_upper, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in CSC upper ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(CSC_upper, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in CSC upper ${s1}$ transpose spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(ELL_low, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in ELL lower ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(ELL_low, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in ELL lower ${s1}$ transpose spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(ELL_upper, vec_x, vec_y)
            call check(error, all(vec_y == vec_y_ref), "error in ELL upper ${s1}$ spmv")
            if (allocated(error)) return

            vec_y = 0._wp
            call spmv(ELL_upper, vec_x, vec_y, op=sparse_op_transpose)
            call check(error, all(vec_y == vec_y_ref), "error in ELL upper ${s1}$ transpose spmv")
            if (allocated(error)) return
        end block
        #:endfor
    end subroutine

    subroutine test_diagonal(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            ${t1}$, allocatable :: dense(:,:)
            type(COO_${s1}$_type) :: COO
            type(CSR_${s1}$_type) :: CSR
            type(CSC_${s1}$_type) :: CSC
            ${t1}$, allocatable :: diagonal(:)

            allocate( dense(4,4) , source = &
                    reshape(real([1,0,0,5, &
                                  0,2,0,0, &
                                  0,6,3,0,&
                                  0,0,7,4],kind=wp),[4,4]) )

            call diag(dense,diagonal)
            call check(error, all(diagonal == [1,2,3,4]) )
            if (allocated(error)) return

            diagonal = 0.0
            call dense2coo( dense , COO )
            call diag( COO , diagonal )
            call check(error, all(diagonal == [1,2,3,4]) )
            if (allocated(error)) return

            diagonal = 0.0
            call coo2csr( COO, CSR )
            call diag( CSR , diagonal )
            call check(error, all(diagonal == [1,2,3,4]) )
            if (allocated(error)) return

            diagonal = 0.0
            call coo2csc( COO, CSC )
            call diag( CSC , diagonal )
            print *, 'diagonal csc:', diagonal
            call check(error, all(diagonal == [1,2,3,4]) )
            if (allocated(error)) return
        end block
        #:endfor
    end subroutine

    subroutine test_add_get_values(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            real(wp) :: dense(5,5), mat(2,2)
            type(COO_${s1}$_type) :: COO
            type(CSR_${s1}$_type) :: CSR
            ${t1}$:: err
            integer :: i, j, locdof(2)

            mat(:,1) = [1,2]; mat(:,2) = [2,1]
            dense = 0._wp
            do i = 0, 3
                dense(1+i:2+i,1+i:2+i) = dense(1+i:2+i,1+i:2+i) + mat
            end do

            call dense2coo(dense,COO)
            call coo2csr(COO,CSR)

            CSR%data = 0._wp

            do i = 0, 3
                locdof(1:2) = [1+i,2+i] 
                call CSR%add(locdof,locdof,mat)
            end do

            call check(error, all(CSR%data == COO%data) )
            if (allocated(error)) return
            err = 0._wp
            do i = 1, 5
                do j = 1, 5
                    err = err + abs(dense(i,j) - CSR%at(i,j))
                end do
            end do
            err = err / 5*5

            call check(error, err <= epsilon(0._wp) )
            if (allocated(error)) return
        end block
        #:endfor
    end subroutine

    subroutine test_sparse_operators(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for matrix in ["COO","CSR","CSC"] # ELL and SELLC are supported but since they have explicit zeros in data array, the tests are less straightforward
        #:for k, t, s in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k}$
            real(wp), parameter :: tol = 1000*epsilon(0._wp)
            real(wp) :: scalar
            integer :: row(10), col(10)
            real(wp) :: data(10)
            type(${matrix}$_${s}$_type) :: a, b, c
            ${t}$:: err

            data(:)   = real([9,-3,4,7,8,-1,8,4,5,6],kind=wp)
            col(:)    = [1,5,1,2,2,3,4,1,3,4]
            row(:)    = [1,1,2,2,3,3,3,4,4,4]
            
            call from_ijv(a, row, col, data)
            call from_ijv(b, row, col, data)
            scalar = 2.0_wp
            
            ! Test sparse + sparse
            c = a + b
            err = sum( abs( c%data - 2.0_wp*a%data ) ) / size(data)
            call check(error, err <= tol, "error in sparse + sparse" )
            if (allocated(error)) return

            ! Test scalar + sparse
            c = scalar + a
            err = sum( abs( c%data - (scalar + a%data) ) ) / size(data)
            call check(error, err <= tol, "error in scalar + sparse" )
            if (allocated(error)) return

            ! Test sparse + scalar
            c = a + scalar
            err = sum( abs( c%data - (a%data + scalar) ) ) / size(data)
            call check(error, err <= tol, "error in sparse + scalar" )
            if (allocated(error)) return

            ! Test sparse * sparse
            c = a * b
            err = sum( abs( c%data - a%data*b%data ) ) / size(data)
            call check(error, err <= tol, "error in sparse * sparse" )
            if (allocated(error)) return

            ! Test scalar * sparse
            c = scalar * a
            err = sum( abs( c%data - (scalar*a%data) ) ) / size(data)
            call check(error, err <= tol, "error in scalar * sparse" )
            if (allocated(error)) return

            ! Test sparse * scalar
            c = a * scalar
            err = sum( abs( c%data - (a%data*scalar) ) ) / size(data)
            call check(error, err <= tol, "error in sparse * scalar" )
            if (allocated(error)) return

            ! Test sparse - sparse
            c = a - b
            err = sum( abs( c%data ) ) / size(data)
            call check(error, err <= tol, "error in sparse - sparse" )
            if (allocated(error)) return

            ! Test scalar - sparse
            c = scalar - a
            err = sum( abs( c%data - (scalar - a%data) ) ) / size(data)
            call check(error, err <= tol, "error in scalar - sparse" )
            if (allocated(error)) return

            ! Test sparse - scalar
            c = a - scalar
            err = sum( abs( c%data - (a%data - scalar) ) ) / size(data)
            call check(error, err <= tol, "error in sparse - scalar" )
            if (allocated(error)) return

            ! Test sparse / sparse
            c = a / b
            err = sum( abs( c%data - 1.0_wp ) ) / size(data)
            call check(error, err <= tol, "error in sparse / sparse" )
            if (allocated(error)) return

            ! Test scalar / sparse
            c = scalar / a
            err = sum( abs( c%data - (scalar / a%data) ) ) / size(data)
            call check(error, err <= tol, "error in scalar / sparse" )
            if (allocated(error)) return

            ! Test sparse / scalar
            c = a / scalar
            err = sum( abs( c%data - (a%data / scalar) ) ) / size(data)
            call check(error, err <= tol, "error in sparse / scalar" )
            if (allocated(error)) return

        end block
        #:endfor
        #:endfor

    end subroutine

    subroutine test_add_block_symmetric_skip(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            integer :: connectivity(3,3)

            real(wp) :: dense(5,5), dense_low(5,5), mat(3,3)
            type(COO_${s1}$_type) :: COO_full, COO_low
            type(CSR_${s1}$_type) :: CSR_full, CSR_low
            type(CSC_${s1}$_type) :: CSC_full, CSC_low
            real(wp)  :: x(5), y(5), y_ref(5)
            ${t1}$:: err
            integer :: i, j, locdof(3)

            connectivity(1:3,1) = [1,2,3]
            connectivity(1:3,2) = [2,3,4]
            connectivity(1:3,3) = [3,4,5]

            mat(:,1) = [1,2,3]
            mat(:,2) = [2,1,4]
            mat(:,3) = [3,4,1]

            dense = 0._wp
            do i = 1, 3
                locdof(1:3) = connectivity(1:3,i)
                dense(locdof,locdof) = dense(locdof,locdof) + mat
            end do

            call dense2coo(dense,COO_full)
            call coo2csr(COO_full,CSR_full)
            call coo2csc(COO_full,CSC_full)
            dense_low = dense
            do i = 1, 5
                do j = i+1, 5
                    dense_low(i,j) = 0._wp
                end do
            end do
            call dense2coo(dense_low,COO_low)
            COO_low%storage = sparse_lower
            call coo2csr(COO_low,CSR_low)
            call coo2csc(COO_low,CSC_low)

            COO_full%data = 0._wp
            COO_low%data = 0._wp
            CSR_full%data = 0._wp
            CSR_low%data = 0._wp
            CSC_full%data = 0._wp
            CSC_low%data = 0._wp
            do i = 1, 3
                locdof(1:3) = connectivity(1:3,i)
                call COO_full%add(locdof,locdof,mat)
                call COO_low%add(locdof,locdof,mat)
                call CSR_full%add(locdof,locdof,mat)
                call CSR_low%add(locdof,locdof,mat)
                call CSC_full%add(locdof,locdof,mat)
                call CSC_low%add(locdof,locdof,mat)
            end do

            call check(error, all(CSR_full%data == COO_full%data) , "error in full CSR ${s1}$ data" )
            if (allocated(error)) return

            call check(error, all(CSR_low%data == COO_low%data) , "error in low CSR ${s1}$ data" )
            if (allocated(error)) return

            x = 1._wp
            y_ref = matmul(dense,x)

            y = 0._wp
            call spmv( CSR_full, x, y )
            call check(error, all(y == y_ref) , "error in full CSR ${s1}$ spmv" )
            if (allocated(error)) return
            
            y = 0._wp
            call spmv( CSR_low, x, y ) 
            call check(error, all(y == y_ref) , "error in low CSR ${s1}$ spmv" )
            if (allocated(error)) return

            y = 0._wp
            call spmv( CSC_full, x, y )
            call check(error, all(y == y_ref) , "error in full CSC ${s1}$ spmv" )
            if (allocated(error)) return
            
            y = 0._wp
            call spmv( CSC_low, x, y ) 
            call check(error, all(y == y_ref) , "error in low CSC ${s1}$ spmv" )
        end block
        #:endfor
        
    end subroutine

    subroutine test_csc2dense(error)
        !> Error handling
        type(error_type), allocatable, intent(out) :: error
        #:for k1, t1, s1 in (KINDS_TYPES)
        block
            integer, parameter :: wp = ${k1}$
            type(COO_${s1}$_type) :: COO
            type(CSC_${s1}$_type) :: CSC
            ${t1}$, allocatable :: dense_original(:,:), dense_converted(:,:)

            ! 1. Create a baseline dense 4x4 matrix
            allocate( dense_original(4,4) , source = &
                    reshape(real([1,0,0,5, &
                                  0,2,0,0, &
                                  0,6,3,0, &
                                  0,0,7,4],kind=wp),[4,4]) )

            ! 2. Convert Dense -> COO -> CSC (Standard pipeline)
            call dense2coo( dense_original , COO )
            call coo2csc( COO, CSC )

            ! 3. Execute the csc2dense conversion
            call csc2dense( CSC, dense_converted )

            ! 4. Verify the converted matrix perfectly matches the original
            call check(error, all(dense_original == dense_converted), "Error: csc2dense conversion failed for kind ${s1}$")
            if (allocated(error)) return
        end block
        #:endfor
    end subroutine
    
end module

program tester
    use, intrinsic :: iso_fortran_env, only : error_unit
    use testdrive, only : run_testsuite, new_testsuite, testsuite_type
    use test_sparse_spmv, only : collect_suite
    implicit none
    integer :: stat, is
    type(testsuite_type), allocatable :: testsuites(:)
    character(len=*), parameter :: fmt = '("#", *(1x, a))'

    stat = 0

    testsuites = [ &
        new_testsuite("sparse", collect_suite) &
        ]

    do is = 1, size(testsuites)
        write(error_unit, fmt) "Testing:", testsuites(is)%name
        call run_testsuite(testsuites(is)%collect, error_unit, stat)
    end do

    if (stat > 0) then
        write(error_unit, '(i0, 1x, a)') stat, "test(s) failed!"
        error stop
    end if
end program
