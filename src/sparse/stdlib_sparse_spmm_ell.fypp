#:include "common.fypp"
#:set KINDS_TYPES = list(zip(REAL_KINDS, REAL_TYPES, REAL_SUFFIX)) + list(zip(CMPLX_KINDS, CMPLX_TYPES, CMPLX_SUFFIX))
#:set fmt = "ELL"
submodule (stdlib_sparse_spmm) stdlib_sparse_spmm_ell
contains
    #:for k, t, s in KINDS_TYPES
    !> Multiply a ${fmt}$ sparse matrix by a dense matrix.
    module subroutine spmm_${fmt.lower()}$_dense_${s}$(sparse_a, dense_b, dense_c, alpha, beta, op)
        type(${fmt}$_${s}$_type), intent(in) :: sparse_a
        ${t}$, intent(in) :: dense_b(:,:)
        ${t}$, intent(inout) :: dense_c(:,:)
        ${t}$, intent(in), optional :: alpha, beta
        character(1), intent(in), optional :: op
        character(1) :: op_
        ${t}$ :: beta_
        integer :: j
        op_ = sparse_op_none
        if (present(op)) op_ = op
        if (op_ /= sparse_op_none .and. op_ /= sparse_op_transpose .and. op_ /= sparse_op_hermitian) &
            error stop 'spmm: invalid op'
        #:if not t.startswith('complex')
        if (op_ == sparse_op_hermitian) op_ = sparse_op_transpose
        #:endif
        if (op_ == sparse_op_none) then
            if (size(dense_b,1) /= sparse_a%ncols .or. size(dense_c,1) /= sparse_a%nrows) &
                error stop 'spmm: incompatible matrix dimensions'
        else
            if (size(dense_b,1) /= sparse_a%nrows .or. size(dense_c,1) /= sparse_a%ncols) &
                error stop 'spmm: incompatible matrix dimensions'
        end if
        if (size(dense_b,2) /= size(dense_c,2)) error stop 'spmm: incompatible matrix dimensions'
        beta_ = zero_${s}$
        if (present(beta)) beta_ = beta
        if (beta_ == zero_${s}$) dense_c = zero_${s}$
        do j = 1, size(dense_b,2)
            call spmv(sparse_a, dense_b(:,j), dense_c(:,j), alpha, beta, op_)
        end do
    end subroutine spmm_${fmt.lower()}$_dense_${s}$

    !> Multiply a dense matrix by a ${fmt}$ sparse matrix.
    module subroutine spmm_dense_${fmt.lower()}$_${s}$(dense_a, sparse_b, dense_c, alpha, beta, op)
        ${t}$, intent(in) :: dense_a(:,:)
        type(${fmt}$_${s}$_type), intent(in) :: sparse_b
        ${t}$, intent(inout) :: dense_c(:,:)
        ${t}$, intent(in), optional :: alpha, beta
        character(1), intent(in), optional :: op
        character(1) :: op_, spmv_op
        ${t}$ :: beta_
        integer :: i
        op_ = sparse_op_none
        if (present(op)) op_ = op
        if (op_ /= sparse_op_none .and. op_ /= sparse_op_transpose .and. op_ /= sparse_op_hermitian) &
            error stop 'spmm: invalid op'
        if (size(dense_a,1) /= size(dense_c,1)) error stop 'spmm: incompatible matrix dimensions'
        if (op_ == sparse_op_none) then
            if (size(dense_a,2) /= sparse_b%nrows .or. size(dense_c,2) /= sparse_b%ncols) &
                error stop 'spmm: incompatible matrix dimensions'
            spmv_op = sparse_op_transpose
        else
            if (size(dense_a,2) /= sparse_b%ncols .or. size(dense_c,2) /= sparse_b%nrows) &
                error stop 'spmm: incompatible matrix dimensions'
            spmv_op = sparse_op_none
        end if
        beta_ = zero_${s}$
        if (present(beta)) beta_ = beta
        if (beta_ == zero_${s}$) dense_c = zero_${s}$
        #:if t.startswith('complex')
        if (op_ == sparse_op_hermitian) then
            block
                ${t}$, allocatable :: temp(:)
                ${t}$ :: alpha_, beta_
                alpha_ = one_${s}$
                beta_ = zero_${s}$
                if (present(alpha)) alpha_ = alpha
                if (present(beta)) beta_ = beta
                allocate(temp(sparse_b%nrows))
                do i = 1, size(dense_a,1)
                    temp = zero_${s}$
                    call spmv(sparse_b, conjg(dense_a(i,:)), temp, op=sparse_op_none)
                    dense_c(i,:) = beta_*dense_c(i,:) + alpha_*conjg(temp)
                end do
            end block
            return
        end if
        #:endif
        do i = 1, size(dense_a,1)
            call spmv(sparse_b, dense_a(i,:), dense_c(i,:), alpha, beta, spmv_op)
        end do
    end subroutine spmm_dense_${fmt.lower()}$_${s}$
    !> Construct the same-format product structure and reusable workspace.
    module subroutine prepare_${fmt.lower()}$_${s}$(a,b,c,plan,stat)
        type(${fmt}$_${s}$_type), intent(in) :: a, b
        type(${fmt}$_${s}$_type), intent(inout) :: c
        type(spmm_plan_type), intent(out) :: plan
        integer, intent(out), optional :: stat
        type(${fmt}$_${s}$_type) :: prepared
        integer :: code
        integer(ilp) :: row, p, slot, width
        call set_status(spmm_success,stat)
        if (.not.allocated(a%data) .or. .not.allocated(b%data)) then
            call set_status(spmm_invalid_input,stat)
            return
        end if
        if (a%ncols /= b%nrows) then
            call set_status(spmm_invalid_input,stat)
            return
        end if
        plan%format = format_ell
        call snapshot(a,size(a%data,1),size(a%data,2),plan%a,code)
        if (code /= spmm_success) then
            call set_status(code,stat)
            return
        end if
        call snapshot(b,size(b%data,1),size(b%data,2),plan%b,code)
        if (code /= spmm_success) then
            call set_status(code,stat)
            return
        end if
        call build_view(plan%a,plan%format)
        call build_view(plan%b,plan%format)
        call symbolic_product(plan,code)
        if (code /= spmm_success) then
            call set_status(code,stat)
            return
        end if
        width = 0
        do row = 1, a%nrows
            width = max(width,plan%c%pointer(row+1)-plan%c%pointer(row))
        end do
        if (int(a%nrows,int64)*width > huge(1_ilp)) then
            call set_status(spmm_invalid_input,stat)
            return
        end if
        call prepared%malloc(a%nrows,b%ncols,width)
        prepared%nnz = size(plan%c%index)
        do row = 1, a%nrows
            do p = plan%c%pointer(row),plan%c%pointer(row+1)-1
                slot = p-plan%c%pointer(row)+1
                prepared%index(row,slot) = plan%c%index(p)
                plan%c%slot(p) = row+(slot-1)*a%nrows
            end do
        end do
        c = prepared
        call snapshot(c,size(c%data,1),size(c%data,2),plan%c,code)
        plan%ready = code == spmm_success
        call set_status(code,stat)
    end subroutine prepare_${fmt.lower()}$_${s}$

    !> Recompute only values without allocating or changing sparse indices.
    module subroutine kernel_${fmt.lower()}$_${s}$(a,b,c,plan,alpha,stat)
        type(${fmt}$_${s}$_type), intent(in) :: a, b
        type(${fmt}$_${s}$_type), intent(inout) :: c
        type(spmm_plan_type), intent(inout) :: plan
        ${t}$, intent(in), optional :: alpha
        integer, intent(out), optional :: stat
        ${t}$ :: alpha_
        integer :: code
        code = spmm_unprepared
        if (.not.plan%ready) then
            call set_status(code,stat)
            return
        end if
        code = spmm_pattern_mismatch
        if (plan%format /= format_ell) then
            call set_status(code,stat)
            return
        end if
        if (.not.allocated(a%data) .or. .not.allocated(b%data) .or. &
                .not.allocated(c%data)) then
            call set_status(code,stat)
            return
        end if
        if (.not.structure_matches(a,size(a%data,1),size(a%data,2),plan%a)) then
            call set_status(code,stat)
            return
        end if
        if (.not.structure_matches(b,size(b%data,1),size(b%data,2),plan%b)) then
            call set_status(code,stat)
            return
        end if
        if (.not.structure_matches(c,size(c%data,1),size(c%data,2),plan%c)) then
            call set_status(code,stat)
            return
        end if
        alpha_ = one_${s}$
        if (present(alpha)) alpha_ = alpha
        call numeric_${s}$(plan,a%data,b%data,c%data,alpha_)
        call set_status(spmm_success,stat)
    end subroutine kernel_${fmt.lower()}$_${s}$

    !> Convenience product with explicit control over structural rebuilding.
    module subroutine spmm_sparse_${fmt.lower()}$_${s}$( &
            a,b,c,alpha,plan,allow_resize,stat)
        type(${fmt}$_${s}$_type), intent(in) :: a, b
        type(${fmt}$_${s}$_type), intent(inout) :: c
        ${t}$, intent(in), optional :: alpha
        type(spmm_plan_type), intent(inout), optional :: plan
        logical, intent(in), optional :: allow_resize
        integer, intent(out), optional :: stat
        type(spmm_plan_type) :: local_plan
        logical :: resize
        integer :: code
        resize = .not.present(plan)
        if (present(allow_resize)) resize = allow_resize
        if (present(plan)) then
            call kernel_${fmt.lower()}$_${s}$(a,b,c,plan,alpha,code)
            if (code /= spmm_success .and. resize) then
                call prepare_${fmt.lower()}$_${s}$(a,b,c,plan,code)
                if (code == spmm_success) &
                    call kernel_${fmt.lower()}$_${s}$(a,b,c,plan,alpha,code)
            end if
        else if (resize) then
            call prepare_${fmt.lower()}$_${s}$(a,b,c,local_plan,code)
            if (code == spmm_success) &
                call kernel_${fmt.lower()}$_${s}$(a,b,c,local_plan,alpha,code)
        else
            code = spmm_unprepared
        end if
        call set_status(code,stat)
    end subroutine spmm_sparse_${fmt.lower()}$_${s}$
    #:endfor
end submodule stdlib_sparse_spmm_ell
