#:include "common.fypp"
#:set KINDS_TYPES = list(zip(REAL_KINDS, REAL_TYPES, REAL_SUFFIX)) + list(zip(CMPLX_KINDS, CMPLX_TYPES, CMPLX_SUFFIX))
!! Sparse matrix-matrix multiplication with separate construction and array kernels.
module stdlib_sparse_spmm
    use stdlib_sparse_constants
    use stdlib_sparse_kinds
    use stdlib_sparse_spmv, only: spmv
    use stdlib_error, only: error_stop
    implicit none
    private
    public :: spmm, spmm_prepare, spmm_success, spmm_invalid_input
    public :: spmm_kernel_coo, spmm_kernel_csr, spmm_kernel_csc
    public :: spmm_kernel_ell, spmm_kernel_sellc
    integer, parameter :: spmm_success = 0 !! Successful operation
    integer, parameter :: spmm_invalid_input = 1 !! Invalid dimensions, storage or workspace

    !! version: experimental
    !!
    !! Sparse products optionally prepare C, then apply a plain-array kernel.
    !! With allow_resize=false, C must already contain the complete product pattern.
    !! [Specifications](../page/specs/stdlib_sparse.html#spmm-sparse-matrix-matrix-product)
    interface spmm
        #:for k, t, s in KINDS_TYPES
        #:for fmt in ["COO", "CSR", "CSC", "ELL", "SELLC"]
        module subroutine spmm_${fmt.lower()}$_dense_${s}$(sparse_a,dense_b,dense_c,alpha,beta,op)
            type(${fmt}$_${s}$_type), intent(in) :: sparse_a
            ${t}$, intent(in) :: dense_b(:,:)
            ${t}$, intent(inout) :: dense_c(:,:)
            ${t}$, intent(in), optional :: alpha, beta
            character(1), intent(in), optional :: op
        end subroutine
        module subroutine spmm_dense_${fmt.lower()}$_${s}$(dense_a,sparse_b,dense_c,alpha,beta,op)
            ${t}$, intent(in) :: dense_a(:,:)
            type(${fmt}$_${s}$_type), intent(in) :: sparse_b
            ${t}$, intent(inout) :: dense_c(:,:)
            ${t}$, intent(in), optional :: alpha, beta
            character(1), intent(in), optional :: op
        end subroutine
        module subroutine spmm_sparse_${fmt.lower()}$_${s}$(a,b,c,alpha,op_a,op_b,allow_resize,work,stat)
            type(${fmt}$_${s}$_type), intent(in) :: a, b
            type(${fmt}$_${s}$_type), intent(inout) :: c
            ${t}$, intent(in), optional :: alpha
            character(1), intent(in), optional :: op_a, op_b
            logical, intent(in), optional :: allow_resize
            integer(ilp), intent(inout), optional, contiguous, target :: work(:)
            integer, intent(out), optional :: stat
        end subroutine
        #:endfor
        #:endfor
    end interface spmm

    !! version: experimental
    !!
    !! Allocate C and construct the structural product of op(A) and op(B).
    !! Numerical values do not affect the pattern; result values are initially zero.
    interface spmm_prepare
        #:for k, t, s in KINDS_TYPES
        #:for fmt in ["COO", "CSR", "CSC", "ELL", "SELLC"]
        module subroutine prepare_${fmt.lower()}$_${s}$(a,b,c,op_a,op_b,stat)
            type(${fmt}$_${s}$_type), intent(in) :: a, b
            type(${fmt}$_${s}$_type), intent(inout) :: c
            character(1), intent(in), optional :: op_a, op_b
            integer, intent(out), optional :: stat
        end subroutine
        #:endfor
        #:endfor
    end interface spmm_prepare

    !! version: experimental
    !!
    !! Apply the product using conforming arrays and caller-owned integer workspace.
    !! C must contain every product position. No pattern validation is performed.
    interface spmm_kernel_coo
    #:for k, t, s in KINDS_TYPES
    module subroutine spmm_kernel_coo_${s}$(op_a,op_b,alpha,shape_a,shape_b, &
        a_data,a_index, &
        b_data,b_index, &
        c_data,c_index,work)
        character(1), intent(in) :: op_a, op_b
        ${t}$, intent(in) :: alpha
        integer(ilp), intent(in) :: shape_a(2), shape_b(2)
        ${t}$, intent(in), contiguous, target :: a_data(:)
        integer(ilp), intent(in), contiguous :: a_index(:,:)
        ${t}$, intent(in), contiguous, target :: b_data(:)
        integer(ilp), intent(in), contiguous :: b_index(:,:)
        ${t}$, intent(inout), contiguous, target :: c_data(:)
        integer(ilp), intent(in), contiguous :: c_index(:,:)
        integer(ilp), intent(inout), contiguous :: work(:)
    end subroutine spmm_kernel_coo_${s}$
    #:endfor
    end interface spmm_kernel_coo

    !! version: experimental
    !!
    !! Apply the product using conforming arrays and caller-owned integer workspace.
    !! C must contain every product position. No pattern validation is performed.
    interface spmm_kernel_csr
    #:for k, t, s in KINDS_TYPES
    module subroutine spmm_kernel_csr_${s}$(op_a,op_b,alpha,shape_a,shape_b, &
        a_data,a_rowptr,a_col, &
        b_data,b_rowptr,b_col, &
        c_data,c_rowptr,c_col,work)
        character(1), intent(in) :: op_a, op_b
        ${t}$, intent(in) :: alpha
        integer(ilp), intent(in) :: shape_a(2), shape_b(2)
        ${t}$, intent(in), contiguous, target :: a_data(:)
        integer(ilp), intent(in), contiguous :: a_rowptr(:)
        integer(ilp), intent(in), contiguous :: a_col(:)
        ${t}$, intent(in), contiguous, target :: b_data(:)
        integer(ilp), intent(in), contiguous :: b_rowptr(:)
        integer(ilp), intent(in), contiguous :: b_col(:)
        ${t}$, intent(inout), contiguous, target :: c_data(:)
        integer(ilp), intent(in), contiguous :: c_rowptr(:)
        integer(ilp), intent(in), contiguous :: c_col(:)
        integer(ilp), intent(inout), contiguous :: work(:)
    end subroutine spmm_kernel_csr_${s}$
    #:endfor
    end interface spmm_kernel_csr

    !! version: experimental
    !!
    !! Apply the product using conforming arrays and caller-owned integer workspace.
    !! C must contain every product position. No pattern validation is performed.
    interface spmm_kernel_csc
    #:for k, t, s in KINDS_TYPES
    module subroutine spmm_kernel_csc_${s}$(op_a,op_b,alpha,shape_a,shape_b, &
        a_data,a_colptr,a_row, &
        b_data,b_colptr,b_row, &
        c_data,c_colptr,c_row,work)
        character(1), intent(in) :: op_a, op_b
        ${t}$, intent(in) :: alpha
        integer(ilp), intent(in) :: shape_a(2), shape_b(2)
        ${t}$, intent(in), contiguous, target :: a_data(:)
        integer(ilp), intent(in), contiguous :: a_colptr(:)
        integer(ilp), intent(in), contiguous :: a_row(:)
        ${t}$, intent(in), contiguous, target :: b_data(:)
        integer(ilp), intent(in), contiguous :: b_colptr(:)
        integer(ilp), intent(in), contiguous :: b_row(:)
        ${t}$, intent(inout), contiguous, target :: c_data(:)
        integer(ilp), intent(in), contiguous :: c_colptr(:)
        integer(ilp), intent(in), contiguous :: c_row(:)
        integer(ilp), intent(inout), contiguous :: work(:)
    end subroutine spmm_kernel_csc_${s}$
    #:endfor
    end interface spmm_kernel_csc

    !! version: experimental
    !!
    !! Apply the product using conforming arrays and caller-owned integer workspace.
    !! C must contain every product position. No pattern validation is performed.
    interface spmm_kernel_ell
    #:for k, t, s in KINDS_TYPES
    module subroutine spmm_kernel_ell_${s}$(op_a,op_b,alpha,shape_a,shape_b, &
        a_data,a_index, &
        b_data,b_index, &
        c_data,c_index,work)
        character(1), intent(in) :: op_a, op_b
        ${t}$, intent(in) :: alpha
        integer(ilp), intent(in) :: shape_a(2), shape_b(2)
        ${t}$, intent(in), contiguous, target :: a_data(:,:)
        integer(ilp), intent(in), contiguous :: a_index(:,:)
        ${t}$, intent(in), contiguous, target :: b_data(:,:)
        integer(ilp), intent(in), contiguous :: b_index(:,:)
        ${t}$, intent(inout), contiguous, target :: c_data(:,:)
        integer(ilp), intent(in), contiguous :: c_index(:,:)
        integer(ilp), intent(inout), contiguous :: work(:)
    end subroutine spmm_kernel_ell_${s}$
    #:endfor
    end interface spmm_kernel_ell

    !! version: experimental
    !!
    !! Apply the product using conforming arrays and caller-owned integer workspace.
    !! C must contain every product position. No pattern validation is performed.
    interface spmm_kernel_sellc
    #:for k, t, s in KINDS_TYPES
    module subroutine spmm_kernel_sellc_${s}$(op_a,op_b,alpha,shape_a,shape_b, &
        a_data,a_rowptr,a_col, &
        b_data,b_rowptr,b_col, &
        c_data,c_rowptr,c_col,work)
        character(1), intent(in) :: op_a, op_b
        ${t}$, intent(in) :: alpha
        integer(ilp), intent(in) :: shape_a(2), shape_b(2)
        ${t}$, intent(in), contiguous, target :: a_data(:,:)
        integer(ilp), intent(in), contiguous :: a_rowptr(:)
        integer(ilp), intent(in), contiguous :: a_col(:,:)
        ${t}$, intent(in), contiguous, target :: b_data(:,:)
        integer(ilp), intent(in), contiguous :: b_rowptr(:)
        integer(ilp), intent(in), contiguous :: b_col(:,:)
        ${t}$, intent(inout), contiguous, target :: c_data(:,:)
        integer(ilp), intent(in), contiguous :: c_rowptr(:)
        integer(ilp), intent(in), contiguous :: c_col(:,:)
        integer(ilp), intent(inout), contiguous :: work(:)
    end subroutine spmm_kernel_sellc_${s}$
    #:endfor
    end interface spmm_kernel_sellc

    ! Shared private array procedures have explicit separate interfaces for portability.
    interface
        module subroutine set_status(code,stat)
            integer, intent(in) :: code
            integer, intent(out), optional :: stat
        end subroutine set_status
        module subroutine product_shape(sa,sb,op_a,op_b,oa,ob,sc,inner,code)
            integer(ilp), intent(in) :: sa(2), sb(2)
            character(1), intent(in), optional :: op_a, op_b
            character(1), intent(out) :: oa, ob
            integer(ilp), intent(out) :: sc(2), inner
            integer, intent(out) :: code
        end subroutine product_shape
        module subroutine compressed_view(outer,inner,pointer,index,transposed,ptr,col,slot)
            integer(ilp), intent(in) :: outer, inner, pointer(:), index(:)
            logical, intent(in) :: transposed
            integer(ilp), allocatable, intent(out) :: ptr(:), col(:)
            integer(ilp), allocatable, intent(out), optional :: slot(:)
        end subroutine compressed_view
        module subroutine coo_view(matrix_shape,index,transposed,ptr,col,slot)
            integer(ilp), intent(in) :: matrix_shape(2), index(:,:)
            logical, intent(in) :: transposed
            integer(ilp), allocatable, intent(out) :: ptr(:), col(:)
            integer(ilp), allocatable, intent(out), optional :: slot(:)
        end subroutine coo_view
        module subroutine ell_view(matrix_shape,index,transposed,ptr,col,slot)
            integer(ilp), intent(in) :: matrix_shape(2), index(:,:)
            logical, intent(in) :: transposed
            integer(ilp), allocatable, intent(out) :: ptr(:), col(:)
            integer(ilp), allocatable, intent(out), optional :: slot(:)
        end subroutine ell_view
        module subroutine sellc_view(matrix_shape,pointer,index,transposed,ptr,col,slot)
            integer(ilp), intent(in) :: matrix_shape(2), pointer(:), index(:,:)
            logical, intent(in) :: transposed
            integer(ilp), allocatable, intent(out) :: ptr(:), col(:)
            integer(ilp), allocatable, intent(out), optional :: slot(:)
        end subroutine sellc_view
        module subroutine product_pattern(outer,span,inner,ap,ai,bp,bi,cp,ci,code)
            integer(ilp), intent(in) :: outer, span, inner, ap(:), ai(:), bp(:), bi(:)
            integer(ilp), allocatable, intent(out) :: cp(:), ci(:)
            integer, intent(out) :: code
        end subroutine product_pattern
        module subroutine sort_indices(indices,scratch,count,span,marker,slice)
            integer(ilp), intent(inout) :: indices(:), scratch(:)
            integer(ilp), intent(in) :: count, span, marker(:), slice
        end subroutine sort_indices
        #:for k, t, s in KINDS_TYPES
        module subroutine numeric_slice_${s}$(row,alpha,ap,ai,as,av,bp,bi,bs,bv,cv,work,conj_a,conj_b)
            integer(ilp), intent(in) :: row, ap(:), ai(:), as(:), bp(:), bi(:), bs(:), work(:)
            ${t}$, intent(in) :: alpha, av(:), bv(:)
            ${t}$, intent(inout) :: cv(:)
            logical, intent(in) :: conj_a, conj_b
        end subroutine numeric_slice_${s}$
        #:endfor
    end interface
end module stdlib_sparse_spmm
