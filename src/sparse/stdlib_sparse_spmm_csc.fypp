#:include "common.fypp"
#:set KINDS_TYPES = list(zip(REAL_KINDS, REAL_TYPES, REAL_SUFFIX)) + list(zip(CMPLX_KINDS, CMPLX_TYPES, CMPLX_SUFFIX))
#:set fmt = "CSC"
submodule (stdlib_sparse_spmm) stdlib_sparse_spmm_csc
contains
    #:for k, t, s in KINDS_TYPES
    !> Multiply a ${fmt}$ sparse matrix by a dense matrix.
    module subroutine spmm_${fmt.lower()}$_dense_${s}$(sparse_a, dense_b, dense_c, alpha, beta, op)
        type(${fmt}$_${s}$_type), intent(in) :: sparse_a
        ${t}$, intent(in) :: dense_b(:,:)
        ${t}$, intent(inout) :: dense_c(:,:)
        ${t}$, intent(in), optional :: alpha, beta
        character(1), intent(in), optional :: op
        character(1) :: op_
        ${t}$ :: beta_
        integer :: j
        op_ = sparse_op_none
        if (present(op)) op_ = op
        if (op_ /= sparse_op_none .and. op_ /= sparse_op_transpose .and. op_ /= sparse_op_hermitian) &
            error stop 'spmm: invalid op'
        #:if not t.startswith('complex')
        if (op_ == sparse_op_hermitian) op_ = sparse_op_transpose
        #:endif
        if (op_ == sparse_op_none) then
            if (size(dense_b,1) /= sparse_a%ncols .or. size(dense_c,1) /= sparse_a%nrows) &
                error stop 'spmm: incompatible matrix dimensions'
        else
            if (size(dense_b,1) /= sparse_a%nrows .or. size(dense_c,1) /= sparse_a%ncols) &
                error stop 'spmm: incompatible matrix dimensions'
        end if
        if (size(dense_b,2) /= size(dense_c,2)) error stop 'spmm: incompatible matrix dimensions'
        beta_ = zero_${s}$
        if (present(beta)) beta_ = beta
        if (beta_ == zero_${s}$) dense_c = zero_${s}$
        do j = 1, size(dense_b,2)
            call spmv(sparse_a, dense_b(:,j), dense_c(:,j), alpha, beta, op_)
        end do
    end subroutine spmm_${fmt.lower()}$_dense_${s}$

    !> Multiply a dense matrix by a ${fmt}$ sparse matrix.
    module subroutine spmm_dense_${fmt.lower()}$_${s}$(dense_a, sparse_b, dense_c, alpha, beta, op)
        ${t}$, intent(in) :: dense_a(:,:)
        type(${fmt}$_${s}$_type), intent(in) :: sparse_b
        ${t}$, intent(inout) :: dense_c(:,:)
        ${t}$, intent(in), optional :: alpha, beta
        character(1), intent(in), optional :: op
        character(1) :: op_, spmv_op
        ${t}$ :: beta_
        integer :: i
        op_ = sparse_op_none
        if (present(op)) op_ = op
        if (op_ /= sparse_op_none .and. op_ /= sparse_op_transpose .and. op_ /= sparse_op_hermitian) &
            error stop 'spmm: invalid op'
        if (size(dense_a,1) /= size(dense_c,1)) error stop 'spmm: incompatible matrix dimensions'
        if (op_ == sparse_op_none) then
            if (size(dense_a,2) /= sparse_b%nrows .or. size(dense_c,2) /= sparse_b%ncols) &
                error stop 'spmm: incompatible matrix dimensions'
            spmv_op = sparse_op_transpose
        else
            if (size(dense_a,2) /= sparse_b%ncols .or. size(dense_c,2) /= sparse_b%nrows) &
                error stop 'spmm: incompatible matrix dimensions'
            spmv_op = sparse_op_none
        end if
        beta_ = zero_${s}$
        if (present(beta)) beta_ = beta
        if (beta_ == zero_${s}$) dense_c = zero_${s}$
        #:if t.startswith('complex')
        if (op_ == sparse_op_hermitian) then
            block
                ${t}$, allocatable :: temp(:)
                ${t}$ :: alpha_, beta_
                alpha_ = one_${s}$
                beta_ = zero_${s}$
                if (present(alpha)) alpha_ = alpha
                if (present(beta)) beta_ = beta
                allocate(temp(sparse_b%nrows))
                do i = 1, size(dense_a,1)
                    temp = zero_${s}$
                    call spmv(sparse_b, conjg(dense_a(i,:)), temp, op=sparse_op_none)
                    dense_c(i,:) = beta_*dense_c(i,:) + alpha_*conjg(temp)
                end do
            end block
            return
        end if
        #:endif
        do i = 1, size(dense_a,1)
            call spmv(sparse_b, dense_a(i,:), dense_c(i,:), alpha, beta, spmv_op)
        end do
    end subroutine spmm_dense_${fmt.lower()}$_${s}$
    !> Multiply sparse operands and return ${fmt}$ storage.
    module subroutine spmm_sparse_${fmt.lower()}$_${s}$(sparse_a,sparse_b,matrix_c,alpha)
        class(sparse_type), intent(in) :: sparse_a, sparse_b
        type(${fmt}$_${s}$_type), intent(out) :: matrix_c
        ${t}$, intent(in), optional :: alpha
        type(CSR_${s}$_type) :: csr_a, csr_b, csr_c
        #:if fmt == "CSC"
        type(COO_${s}$_type) :: coo_c
        select type(sparse_a)
        type is(CSC_${s}$_type)
            select type(sparse_b)
            type is(CSC_${s}$_type)
                call csc_product_${s}$(sparse_a,sparse_b,matrix_c,alpha)
                return
            end select
        end select
        #:elif fmt == "CSR"
        select type(sparse_a)
        type is(CSR_${s}$_type)
            select type(sparse_b)
            type is(CSR_${s}$_type)
                call csr_product_${s}$(sparse_a,sparse_b,matrix_c,alpha)
                return
            end select
        end select
        #:endif
        select type(sparse_a)
        type is(CSR_${s}$_type)
            select type(sparse_b)
            type is(CSR_${s}$_type)
                call csr_product_${s}$(sparse_a,sparse_b,csr_c,alpha)
                call csr2coo(csr_c,coo_c)
                call coo2csc(coo_c,matrix_c)
                return
            end select
        end select
        if (sparse_a%storage /= sparse_full .or. sparse_b%storage /= sparse_full) &
            error stop 'spmm: sparse x sparse requires full storage'
        if (sparse_a%ncols /= sparse_b%nrows) error stop 'spmm: incompatible matrix dimensions'
        call to_csr_${s}$(sparse_a,csr_a)
        call to_csr_${s}$(sparse_b,csr_b)
        call csr_product_${s}$(csr_a,csr_b,csr_c,alpha)
        #:if fmt == "COO"
        call csr2coo(csr_c,matrix_c)
        #:elif fmt == "CSR"
        matrix_c = csr_c
        #:elif fmt == "CSC"
        call csr2coo(csr_c,coo_c)
        call coo2csc(coo_c,matrix_c)
        #:elif fmt == "ELL"
        call csr2ell(csr_c,matrix_c)
        #:elif fmt == "SELLC"
        call csr2sellc(csr_c,matrix_c)
        #:endif
    end subroutine spmm_sparse_${fmt.lower()}$_${s}$

    !> Convert a sparse operand of the expected numeric kind to CSC.
    module subroutine to_csc_${s}$(input,output)
        class(sparse_type), intent(in) :: input
        type(CSC_${s}$_type), intent(out) :: output
        type(CSR_${s}$_type) :: csr
        type(COO_${s}$_type) :: coo
        select type(input)
        type is(CSC_${s}$_type)
            output = input
        type is(COO_${s}$_type)
            coo = input
            call coo2ordered(coo,sort_data=.true.)
            call coo2csc(coo,output)
        type is(CSR_${s}$_type)
            call csr2coo(input,coo)
            call coo2csc(coo,output)
        type is(ELL_${s}$_type)
            call to_csr_${s}$(input,csr)
            call csr2coo(csr,coo)
            call coo2csc(coo,output)
        type is(SELLC_${s}$_type)
            call to_csr_${s}$(input,csr)
            call csr2coo(csr,coo)
            call coo2csc(coo,output)
        class default
            error stop 'spmm: sparse operands must match the result kind'
        end select
    end subroutine to_csc_${s}$

    !> Gustavson-style column accumulator for CSC x CSC.
    !! The touched-index workspace and sort/scan choice follow the approach
    !! used by Julia SparseArrays (src/matmul.jl).
    module subroutine csc_product_${s}$(matrix_a,matrix_b,matrix_c,alpha)
        type(CSC_${s}$_type), intent(in) :: matrix_a, matrix_b
        type(CSC_${s}$_type), intent(out) :: matrix_c
        ${t}$, intent(in), optional :: alpha
        ${t}$ :: alpha_, value
        ${t}$, allocatable :: work(:), data(:)
        integer(ilp), allocatable :: marker(:), touched(:), scratch(:), rows(:), colptr(:)
        integer(ilp) :: i, j, p, q, row, nnz, capacity, ntouched
        integer(ilp) :: counts(0:255), positions(0:255), bucket, shift
        integer(int64) :: estimated_capacity
        if (matrix_a%storage /= sparse_full .or. matrix_b%storage /= sparse_full) &
            error stop 'spmm: CSC x CSC requires full storage'
        if (matrix_a%ncols /= matrix_b%nrows) error stop 'spmm: incompatible matrix dimensions'
        alpha_ = one_${s}$
        if (present(alpha)) alpha_ = alpha
        allocate(work(matrix_a%nrows),source=zero_${s}$)
        allocate(marker(matrix_a%nrows),source=0_ilp)
        allocate(touched(matrix_a%nrows))
        allocate(colptr(matrix_b%ncols+1))
        ! Estimate the number of products before allocating output buffers.
        estimated_capacity = int(matrix_a%nnz,int64)*int(matrix_b%nnz,int64) / &
            int(max(1_ilp,matrix_a%ncols),int64)
        estimated_capacity = min(estimated_capacity, &
            int(matrix_a%nrows,int64)*int(matrix_b%ncols,int64))
        capacity = int(max(1_int64,min(estimated_capacity,int(huge(1_ilp),int64))),ilp)
        allocate(rows(capacity),data(capacity))
        nnz = 0
        colptr(1) = 1
        do j = 1, matrix_b%ncols
            ntouched = 0
            do p = matrix_b%colptr(j), matrix_b%colptr(j+1)-1
                i = matrix_b%row(p)
                do q = matrix_a%colptr(i), matrix_a%colptr(i+1)-1
                    row = matrix_a%row(q)
                    if (marker(row) /= j) then
                        ntouched = ntouched + 1
                        touched(ntouched) = row
                        marker(row) = j
                        work(row) = zero_${s}$
                    end if
                    work(row) = work(row) + matrix_a%data(q)*matrix_b%data(p)
                end do
            end do
            if (ntouched > 1) then
                if (ntouched < matrix_a%nrows/2) then
                    if (ntouched <= 64) then
                        do q = 2, ntouched
                            row = touched(q)
                            i = q - 1
                            do while (i >= 1)
                                if (touched(i) <= row) exit
                                touched(i+1) = touched(i)
                                i = i - 1
                            end do
                            touched(i+1) = row
                        end do
                    else
                        if (.not.allocated(scratch)) allocate(scratch(matrix_a%nrows))
                        ! Stable byte-wise radix sort of touched row indices.
                        do shift = 0, 24, 8
                            if (ishft(matrix_a%nrows,-shift) == 0) exit
                            counts = 0
                            do q = 1, ntouched
                                bucket = ibits(touched(q),shift,8)
                                counts(bucket) = counts(bucket) + 1
                            end do
                            positions(0) = 1
                            do bucket = 1, 255
                                positions(bucket) = positions(bucket-1) + counts(bucket-1)
                            end do
                            do q = 1, ntouched
                                bucket = ibits(touched(q),shift,8)
                                scratch(positions(bucket)) = touched(q)
                                positions(bucket) = positions(bucket) + 1
                            end do
                            touched(:ntouched) = scratch(:ntouched)
                        end do
                    end if
                else
                    ntouched = 0
                    do row = 1, matrix_a%nrows
                        if (marker(row) /= j) cycle
                        ntouched = ntouched + 1
                        touched(ntouched) = row
                    end do
                end if
            end if
            do q = 1, ntouched
                row = touched(q)
                value = alpha_*work(row)
                if (value == zero_${s}$) cycle
                if (nnz == capacity) then
                    block
                        integer(ilp), allocatable :: new_rows(:)
                        ${t}$, allocatable :: new_data(:)
                        allocate(new_rows(2*capacity),new_data(2*capacity))
                        new_rows(:nnz) = rows(:nnz)
                        new_data(:nnz) = data(:nnz)
                        call move_alloc(new_rows,rows)
                        call move_alloc(new_data,data)
                        capacity = 2*capacity
                    end block
                end if
                nnz = nnz + 1
                rows(nnz) = row
                data(nnz) = value
            end do
            colptr(j+1) = nnz + 1
        end do
        call matrix_c%malloc(matrix_a%nrows,matrix_b%ncols,nnz)
        matrix_c%colptr = colptr
        matrix_c%row = rows(:nnz)
        matrix_c%data = data(:nnz)
    end subroutine csc_product_${s}$

    #:endfor
end submodule stdlib_sparse_spmm_csc
