#:include "common.fypp"
module stdlib_linalg_constants
     use stdlib_kinds, only: sp, dp, xdp, qp, int32, int64, lk
     use, intrinsic :: ieee_arithmetic, only: ieee_is_nan, ieee_is_finite
     !$ use omp_lib
     implicit none
     public

     ! Checks whether BLAS is provided by an external library
#ifdef STDLIB_EXTERNAL_BLAS     
     logical(lk), parameter :: external_blas_ilp32 = .true._lk
#else
     logical(lk), parameter :: external_blas_ilp32 = .false._lk
#endif   
#ifdef STDLIB_EXTERNAL_BLAS_I64    
     logical(lk), parameter :: external_blas_ilp64 = .true._lk
#else
     logical(lk), parameter :: external_blas_ilp64 = .false._lk
#endif   

#ifdef STDLIB_EXTERNAL_LAPACK
     logical(lk), parameter :: external_lapack_ilp32 = .true._lk
#else
     logical(lk), parameter :: external_lapack_ilp32 = .false._lk
#endif   
#ifdef STDLIB_EXTERNAL_LAPACK_I64    
     logical(lk), parameter :: external_lapack_ilp64 = .true._lk
#else
     logical(lk), parameter :: external_lapack_ilp64 = .false._lk
#endif   

     ! Generic checks for external libraries
     logical(lk), parameter :: external_blas   = external_blas_ilp32   .or. external_blas_ilp64
     logical(lk), parameter :: external_lapack = external_lapack_ilp32 .or. external_lapack_ilp64

     ! Support both 32-bit (ilp) and 64-bit (ilp64) integer kinds
     integer, parameter :: ilp   = int32
     integer, parameter :: ilp64 = #{if WITH_ILP64}# int64 #{else}# -1 #{endif}#
     private            :: int32, int64

     !> Check for an ordered complex conjugate pair with componentwise relative tolerance.
     interface are_complex_conjugate
        #:for ck,ct,ci in CMPLX_KINDS_TYPES
        module procedure are_complex_conjugate_${ck}$
        #:endfor
     end interface are_complex_conjugate

     private :: ieee_is_finite
     #:for rk,rt,ri in REAL_KINDS_TYPES
     private :: eigenvalue_component_is_close_${rk}$
     #:endfor
     #:for ck,ct,ci in CMPLX_KINDS_TYPES
     private :: are_complex_conjugate_${ck}$
     #:endfor

     contains

     #:for rk,rt,ri in REAL_KINDS_TYPES
     elemental logical(lk) function eigenvalue_component_is_close_${rk}$(a,b) result(close)
        ${rt}$, intent(in) :: a,b
        real(${rk}$) :: scale

        ! Match infinities exactly, without subtracting them or using an infinite tolerance.
        close = a==b
        if (close) return
        if (.not.ieee_is_finite(a) .or. .not.ieee_is_finite(b)) return

        ! Unequal finite values have a nonzero scale. Normalize before subtracting.
        scale = max(abs(a),abs(b))
        ! GGEV scales and divides the two members separately.
        close = abs(a/scale-b/scale)<=8*epsilon(scale)
     end function eigenvalue_component_is_close_${rk}$
     #:endfor

     #:for ck,ct,ci in CMPLX_KINDS_TYPES
     elemental logical(lk) function are_complex_conjugate_${ck}$(a,b) result(conjugate)
        ${ct}$, intent(in) :: a,b

        conjugate = aimag(a)>0.0_${ck}$ .and. aimag(b)<0.0_${ck}$
        if (.not.conjugate) return
        conjugate = eigenvalue_component_is_close_${ck}$(real(a,kind=${ck}$),real(b,kind=${ck}$))
        if (.not.conjugate) return
        conjugate = eigenvalue_component_is_close_${ck}$(aimag(a),-aimag(b))
     end function are_complex_conjugate_${ck}$
     #:endfor
     
end module stdlib_linalg_constants
